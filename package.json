{
  "name": "antigravity-cli-multi-accounts",
  "version": "0.3.0",
  "description": "Installer and CLI for switching Google Antigravity CLI (agy) accounts across Windows, WSL, and Unix shells.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "antigravity-cli-multi-accounts": "cli.cjs"
  },
  "files": [
    "ag-switch.cjs",
    "ag-session-start.cjs",
    "cli.cjs",
    "install.cjs",
    "install.cmd",
    "install.sh",
    "LICENSE",
    "lib/store/io.cjs",
    "lib/store/accounts.cjs",
    "lib/store/lock.cjs",
    "lib/auth/guard.cjs",
    "lib/auth/refresh.cjs",
    "lib/auth/identity.cjs",
    "lib/actions/switch.cjs",
    "lib/actions/switch-pipeline.cjs",
    "lib/actions/sync.cjs",
    "lib/actions/list.cjs",
    "lib/actions/remove.cjs",
    "lib/actions/rename.cjs",
    "lib/actions/usage.cjs",
    "lib/output/accounts.cjs",
    "lib/output/messages.cjs",
    "lib/proc/sessions.cjs",
    "lib/usage/fetch.cjs",
    "lib/usage/format.cjs",
    "lib/usage/cache.cjs",
    "README.md",
    "uninstall.cjs",
    "uninstall.cmd",
    "uninstall.sh"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "antigravity-cli",
    "antigravity",
    "google",
    "oauth",
    "switcher",
    "wsl",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecats1105/AntigravityCLIMultiAccounts.git"
  },
  "homepage": "https://github.com/thecats1105/AntigravityCLIMultiAccounts#readme",
  "bugs": {
    "url": "https://github.com/thecats1105/AntigravityCLIMultiAccounts/issues"
  },
  "scripts": {
    "pack:check": "npm pack --dry-run",
    "test": "node --test tests/guard.test.cjs tests/refresh.test.cjs tests/identity.test.cjs tests/io.test.cjs tests/lock.test.cjs tests/accounts.test.cjs tests/pipeline.test.cjs tests/cli-switch.test.cjs tests/usage-fetch.test.cjs tests/usage-format.test.cjs"
  }
}
